{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dadoooo",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1273fd94-bfd2-4f7a-a668-534ee2b4b9a5","database_name": "web-appdadoo" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "bcf72f3c90464c0b94224a825ebf3ef1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
